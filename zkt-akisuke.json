 "blocks": [
  {
   "id": "zkt-akisuke-0001",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "永久四年四月四日鳥羽殿の歌合、卯の花",
   "author": "",
   "text": "一朝日山ふもとの里の卯花をさらせる布と思ひける哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0002",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "郭公",
   "author": "",
   "text": "一覺束なまつ人からの時鳥など二聲と來鳴かざるらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0003",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "萬蒲",
   "author": "",
   "text": "萬代をふべき淀野の萬蒲草永き妻とや君も見るらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0004",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "早苗",
   "author": "",
   "text": "一色深く門田の早苗成にけり急げ賤のをふしも社たて",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0005",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "戀",
   "author": "",
   "text": "我戀の心にかなふ物ならば人のつらさも恨みざらまし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0006",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "六條宰相の家の歌合、霞",
   "author": "",
   "text": "一年ごとに變らぬものは春霞龍田の山のけしき也けり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0007",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "月",
   "author": "",
   "text": "んか計り照る月なれや眞葛はふ森の下草數みゆる迄",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0008",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "祝",
   "author": "",
   "text": "九限りても君が齡は石〓水流れむよには絕じとぞ思ふ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0009",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "權辨伊通の許にて曉月聞郭公といふことを",
   "author": "",
   "text": "0月影に等ねきたれば時鳥なく山のはによこ雲わたる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0010",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "人のもとより歸りてあしたに",
   "author": "",
   "text": "一梓弓かへるあしたの思には引比ぶべき物なかりけり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0011",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "修理大夫長實歌合せられしに、紅葉",
   "author": "",
   "text": "一秋ごとに誰かそむらむぬし知らぬから紅の衣手の森",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0012",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "雅定中將の歌合に、郭公",
   "author": "",
   "text": "ささ波や舟木の山の時鳥聲をほにあげて鳴渡るなり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0013",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "戀",
   "author": "",
   "text": "知知ららめや岩陰におふる白菅のね深く思ふ心有とは",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0014",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "人のもとへ",
   "author": "",
   "text": "正こひしてふもじの關守幾度か我かきつらむ心盡しに",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0015",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "六條宰相のもとにて寄社月といふ題を",
   "author": "",
   "text": "だ三笠山もりくる月の〓ければ神の心も澄やしぬらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0016",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "白河院にて關路月を",
   "author": "",
   "text": "に達坂の關に〓水の徹りせば爭でか月の影をとめまし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0017",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "右兵衛督の家の歌合に、夏戀",
   "author": "",
   "text": "〓友衣ひとへにつらき人戀る我心こそうらなかりけれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0018",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "悦を加ふるたびの唐衣怪しくなどかたちうかるらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0019",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "越前守忠盛あきはぎといふはしたものにものいふをいといたうしのぶと聞きて遣す",
   "author": "",
   "text": "○いつはらでしかと答へよ秋萩を柵ふすと聞くは誠か",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0020",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "睦月の八日春立ちけるに子日にあたりたるに鶯の鳴くを",
   "author": "",
   "text": "一今日やさは雪うちとけて鶯の都に出る初音なるらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0021",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "院位おりさせ給ひて後初めて人々に和歌よませさせ給ふに花契還年といふことを仕うまつれる",
   "author": "",
   "text": "三萬代に見べき花の色なれど今日の匂はいつか忘れむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0022",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "櫻",
   "author": "",
   "text": "ㅋ『今日咲てあすは靑葉になる花を見捨て歸る人も有見",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0023",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "惜むとて幾日もあらじ山櫻心のまゝに折りて歸らむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0024",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "散る花を惜むばかりや世中の人の心の變らざるらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0025",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "藤",
   "author": "",
   "text": "2然紫の色のゆかりに藤の花かゝれる松もむつまじき哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0026",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "郭公",
   "author": "",
   "text": "限たれあ鳴でもやまじ時鳥人苦しめに待れざらなむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0027",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "AF郭郭公心も空にあくがれて夜がれがちなる深山べの里",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0028",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "女郎花",
   "author": "",
   "text": "起白露や心おくらむ女郞花色めく野べに人かよふとて",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0029",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "戀",
   "author": "",
   "text": "20年ふれど人もすさめぬ我が戀や朽木の柚の谷の埋木",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0030",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一个はさは逢見む迄は難く共命とならむ言のはもがな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0031",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "懲わびてねぬよ積れば敷妙の枕さへ社疎くなりけれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0032",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "逢ふとみて現のかひはなけれども儚き夢ぞ命也ける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0033",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "云ね共下はいとなし爲鳥の浮たる戀と思はざらなむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0034",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "いろなりしとし三月盡の心を",
   "author": "",
   "text": "思遺れ廻りあふべき春だにも立別るゝは悲しき物を",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0035",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "前木工頭俊賴撰集うけたまはりてよめらむ歌をとたび〓〓云はれしかば遺すとて",
   "author": "",
   "text": "加家の風吹ぬ物故はづかしの森の言の葉散らし果つる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0036",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "爭でかは森の言の葉忍ぶべき木高き宿の風の繁きに",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0037",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "絕えにし人の許よりついでありて消息したるに契りしことを賴みけるはかなさなど怨じたれば",
   "author": "",
   "text": "風吹ばさこそは絕れ絕れども又かきつけつ笹蟹の絲",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0038",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "美作にて月をみて",
   "author": "",
   "text": "過過ららむ都の〓ともとふべきに雲のよそにも渡る月哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0039",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "知らぬことを人の申せるによりて白河院の御かしこまりなる頃唐の鏡の一尺ばかりなるを北野に奉るとて書きつけし",
   "author": "",
   "text": "2身につみて照しをさめよ增銳たが僞も曇りあらすな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0040",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "そのことのあらはれにしこそ世の末ともなく哀なりしか年比の人かくれにしかば山里にわたりてとかくのことはするに末にもなりぬればことさらに京にいでそめて曉かへるに鳥の鳴き侍りぬなど人のいそげば",
   "author": "",
   "text": "一いつのまに身を山賤になしはてゝ都を旅と思なる覽",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0041",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "わざのことヾもはてゝみな人京へ出でぬれど我が身はなほしばしと思ひてあるに時雨のせし日中將の上のもとへ",
   "author": "",
   "text": "一誰もみな花の都へちりはてゝ獨しぐるゝ秋の山ざと",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0042",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "身のうれへあるころ賀茂にまゐりて",
   "author": "",
   "text": "〓〓我〓むかもの川波立返り嬉しきせヾにあふ由もがな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0043",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "かきたる方を御前にむかへておせと仰せごとありければしかなむおしなほすとみたまへしと語りしはまことにや",
   "author": "",
   "text": "五二ののく音計りや春ならむ花ちりにけるみ山べの里",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0044",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "五かゝりける心〓しの牛のこをたれ東路の駒と云けむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0045",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓波波江の葦間に宿る月みれば我身一つも沈まざり見",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0046",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "薄戀",
   "author": "",
   "text": "〓いつとなく忍ぶも苦し篠薄ほに出て人に逢由もがな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0047",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "蘭戀",
   "author": "",
   "text": "〓我妹子がすそのに匂ふ藤袴思ひそめてし心たがふな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0048",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "菊祝",
   "author": "",
   "text": "ね〓君が世は限りも知ず長月の菊を幾度つまむとすらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0049",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "こもりゐたりし頃月のあかき夜平等院僧正行なのもとに奉りし",
   "author": "",
   "text": "〓身をつめばたなびく雲もなき空に心細くも澄る月哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0050",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "冬の春日祭に奉幣すとて身の沈みゐる事を思ひて御幣に書きつけし",
   "author": "",
   "text": "〓枯はつる藤の末葉の悲しきはたゞ春の日を賴む計ぞ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0051",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "或る所に淡路といふ女乃にたび〓〓せうそこすれど返りごともなければ",
   "author": "",
   "text": "ごいかにせむとふひも今はたて佗ぬ聲も通はぬ淡路島山",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0052",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "つれなくて過ぐる女の人に語らひつきてあづまのかたへなむときけば心細く思ひけるに粟津といふ所より云ひおこせたりし",
   "author": "",
   "text": "ミなる粟よ粟津の原のあはず共今歸りこむ葛の末はに",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0053",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "粟津野の葛の末葉の返る迄ありやはすべき露の命は",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0054",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "國などもさりにし後さてのみやはとて公文考ふるに左大辨宰相爲隆勸解由使長官なればさたする文などあるほどに消息ありみれば立春に後今日のつかさの奏にあはせむとていそがせ給へばとくるよし考ふるつかさのをさ詠め侍りて御使につけて",
   "author": "",
   "text": "1ををね縣の水の凍れるをさの春風けふぞときつる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0055",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "か風風にあがたの氷とけぬれば沈む水層も顕れにけり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0056",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓ももがが富富の高ねに雲消て〓見が關に澄る月影",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0057",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "紅葉",
   "author": "",
   "text": "山姫にちへの錦をたむけても散紅葉ばを爭で留めむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0058",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "戀",
   "author": "",
   "text": "つつからむ言葉もがな佗つゝは恨てだにも慰ぁにせむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0059",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓唐のたまつむ舟のもどろけば思ひ定めむ方も覺えず",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0060",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一風を痛み玉つむ卅のもどろきは君計社まほに定めし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0061",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "播磨守家成朝臣歌合せしに、月",
   "author": "",
   "text": "〓いか計隈なく照す月なれば心の間も晴るゝなるらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0062",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "鹿",
   "author": "",
   "text": "山山のこたふる山に鳴鹿は己が聲をや友ときくらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0063",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "戀",
   "author": "",
   "text": "東屋の軒のかやまの忍草こひをば人の忍ぶものかは",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0064",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "琳賢がもとより酒を贈るとて萩の花さかりはよささけ世の中になしこの頃よき酒とりいでたる瓶にはかならず物を入れでなむ返すといはせたれば近江守なりしをりにて坂田郡の檢田の廳宣をいれてやるとて",
   "author": "",
   "text": "野野ににて露けき華をみるよりも秋は坂田の數を數へよ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0065",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "〓數數べき山田の壺の內に入ば萩の情にしく花ぞなき",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0066",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "八月十五夜中宮の御方にうへ渡らせ給ひて月の歌人々よませさせ給ひしに",
   "author": "",
   "text": "〓名に高き今宵の月をみる程や心の內の晴間なるらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0067",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "播磨守家成朝臣歌合せしに、落葉",
   "author": "",
   "text": "〓紅に瀧の白絲そめてけり案の紅葉やまなく散るらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0068",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "祝",
   "author": "",
   "text": "幾らとか云べかるらむ萬代も君が爲には數ならぬ哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0069",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "火きりとて近江より貫御に參らするもちひは國司のれうはことに夥しくおほきにて人々のそうするを前左衞門佐基俊君のもとへふるとて",
   "author": "",
   "text": "0よしあしも〓き鏡ぞ照すなる心の程は是にてを見よ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0070",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "返し",
   "author": "",
   "text": "〓〓〓の野寺の鏡ならねどもよそなる人の心をぞみる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0071",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一身身には都の手振飽果の鄙へ誘はむあづまつもがな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0072",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "大宮中納言の家の歌合に、櫻",
   "author": "",
   "text": "白雲のたなびく峯の櫻花薫らざりせば爭で知らまし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0073",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "爲",
   "author": "",
   "text": "〓ののの時にとまらすば夜深き聲をいかで聞かまし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0074",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "霞",
   "author": "",
   "text": "炭炭まの畑に咽ぶをの山は峯の霞もおもなれにけり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0075",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "月",
   "author": "",
   "text": "山山の端に關守据よ龍田姫惜むも知らぬ月やとまると",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0076",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "紅葉",
   "author": "",
   "text": "苔のむす岩陰まゆみ色深しこれを嵐に知せずもがな",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0077",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "戀",
   "author": "",
   "text": "情なき言のはさへも懷しき戀しきなかに通ふと思へば",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0078",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "內にて遠聞搆衣の心を人々によませさせ給ふに",
   "author": "",
   "text": "誰誰爲爲が爲と急ぐなるらむよもすがら槇の島人衣うつ也",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0079",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "雨後草深と云ふ題を",
   "author": "",
   "text": "2かかぞいろと賴むも著しよはの雨に小萩が原の丈ぞ增れる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0080",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "鍛冶井宮法印世を恨みて大原にこもりゐ給へるに師走ばかりに奉る",
   "author": "",
   "text": "『炭竈の烟ばかりは立ずとも山里いかに寂しかるらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0081",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "華のさかりに人々まうできて花の下におりゐて偏愛〓ととふふことをよむに",
   "author": "",
   "text": "我宿の物とも云じ櫻花かゝる月日はあらじとぞ思ふ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0082",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "灌佛",
   "author": "",
   "text": "世中にけふぞ佛の立いでヽ顯れたまふ水は汲みける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0083",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "郭公",
   "author": "",
   "text": "〓時鳥さてしもやまじ物故に思はせたりや小夜更る迄",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0084",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "七夕",
   "author": "",
   "text": "1月月卅升をめりこや彥星の天の戶渡り",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0085",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "重陽",
   "author": "",
   "text": "同じくは九重に咲け菊の花月口の數にかなふ計りに",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0086",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "歳暮",
   "author": "",
   "text": "一ぐくれれ年年數數れれば我身も末に成にける哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0087",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "長明月",
   "author": "",
   "text": "三三山みねに朝日の移ろへば立田の川に月ぞ殘れる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0088",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "百洲川",
   "author": "",
   "text": "名のみしてさしも嵐を百湖川ゆゝしき瀨をば我ぞ過にし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0089",
   "pid": "873676",
   "pages": [
    94
   ],
   "no": null,
   "kotobagaki": "祝",
   "author": "",
   "text": "00君が代にくらぶの山の岩ね松幾度計り生ひ變りなむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0090",
   "pid": "873676",
   "pages": [
    95
   ],
   "no": null,
   "kotobagaki": "長承元年十二月廿三日內裏の和歌題十五首、春",
   "author": "",
   "text": "。其色とめには見えぬを春雨の野べの緣を爭で染らむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0091",
   "pid": "873676",
   "pages": [
    95
   ],
   "no": null,
   "kotobagaki": "歸雁",
   "author": "",
   "text": "〓。契りけむ程や過ぬと急ぐらむ夜もすがらに歸る雁音",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0092",
   "pid": "873676",
   "pages": [
    95
   ],
   "no": null,
   "kotobagaki": "梅",
   "author": "",
   "text": "Dかをらずば誰か知らまし梅の花しらつき山の雪の略",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0093",
   "pid": "873676",
   "pages": [
    95
   ],
   "no": null,
   "kotobagaki": "夏夜",
   "author": "",
   "text": "誠にや明しかぬらむ夏の夜を獨寢覺の人にとはヾや",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0094",
   "pid": "873676",
   "pages": [
    95
   ],
   "no": null,
   "kotobagaki": "照射",
   "author": "",
   "text": "100弓弓高圓山に燈す火は火串にかけているにや有らむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0095",
   "pid": "873676",
   "pages": [
    95
   ],
   "no": null,
   "kotobagaki": "罪麥",
   "author": "",
   "text": "わ朝まだき折れふしにけり終夜露おきあかす撫子の花",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0096",
   "pid": "873676",
   "pages": [
    95
   ],
   "no": null,
   "kotobagaki": "蟲",
   "author": "",
   "text": "o聲たかしすこしたちのけ養さこそは草の枕なりとも",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0097",
   "pid": "873676",
   "pages": [
    95
   ],
   "no": null,
   "kotobagaki": "霜",
   "author": "",
   "text": "%かるの池の入江を廻る明島の上毛はだらに置る朝霜",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0098",
   "pid": "873676",
   "pages": [
    95
   ],
   "no": null,
   "kotobagaki": "千鳥",
   "author": "",
   "text": "か近江路や野島が崎の濱風に夕波千鳥立ちさわぐなり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0099",
   "pid": "873676",
   "pages": [
    95
   ],
   "no": null,
   "kotobagaki": "落葉",
   "author": "",
   "text": "。紅葉ばをよもの嵐は誘へども皆木の本に返る也けり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0100",
   "pid": "873676",
   "pages": [
    95
   ],
   "no": null,
   "kotobagaki": "初戀",
   "author": "",
   "text": "一昔より人惑ふとは聞しかど山てふ山に今日よりぞいる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0101",
   "pid": "873676",
   "pages": [
    95
   ],
   "no": null,
   "kotobagaki": "忍戀",
   "author": "",
   "text": "淺ましや千島のえぞの盡るなるとくきのや社區はもるなれ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-akisuke-0102",
   "pid": "873676",
   "pages": [
    95
   ],
   "no": null,
   "kotobagaki": "會不逢戀",
   "author": "",
   "text": "一一とと祈祈らざりしをかひもなく心定めぬ浮島の神",
   "sachu": "",
